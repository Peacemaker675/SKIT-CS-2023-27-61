# Copy to .env:  cp .env.example .env
# Host values below are for running the backend directly on your machine;
# docker-compose.yml overrides POSTGRES_HOST / REDIS_HOST / INFLUX_HOST with
# container hostnames.

# ---- Flask ----
FLASK_ENV=development
DEBUG=False
# Also used to sign JWTs - change this to a long random string
SECRET_KEY=change-me

# ---- PostgreSQL ----
POSTGRES_USER=intelliroute
POSTGRES_PASSWORD=intelliroute
POSTGRES_DB=intelliroute
# Full SQLAlchemy URI (read by backend/app/config.py)
POSTGRES_HOST=postgresql+psycopg2://intelliroute:intelliroute@localhost:5432/intelliroute

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# The compose Redis has no password; leave empty unless you configure one
REDIS_PASS=
REDIS_SSL=False

# ---- InfluxDB 3 Core ----
INFLUX_HOST=http://localhost:8181
# Required by the client; ignored while the compose server runs --without-auth
INFLUXDB_TOKEN=dev-token
INFLUX_ORG=intelliroute
# InfluxDB 3 database name (created automatically on first write)
INFLUX_BUCKET=traffic
